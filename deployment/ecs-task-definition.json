{
  "_comment": "ECS task definition for Battery Knowledge Management App. Single container: uvicorn serves both the FastAPI backend and the built React frontend. Replace all PLACEHOLDER_ values before registering.",
  "family": "knowledge-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::PLACEHOLDER_ACCOUNT_ID:role/knowledge-app-execution-role",
  "taskRoleArn": "arn:aws:iam::PLACEHOLDER_ACCOUNT_ID:role/knowledge-app-task-role",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "PLACEHOLDER_ACCOUNT_ID.dkr.ecr.us-west-2.amazonaws.com/knowledge-app:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8003,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PAPERS_STORAGE", "value": "s3" },
        { "name": "PAPERS_S3_BUCKET", "value": "astrolabe-datalake" },
        { "name": "AWS_REGION", "value": "us-west-2" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-west-2:PLACEHOLDER_ACCOUNT_ID:secret:knowledge-app/db-url"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-west-2:PLACEHOLDER_ACCOUNT_ID:secret:knowledge-app/api-keys:anthropic_api_key::"
        },
        {
          "name": "SEMANTIC_SCHOLAR_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-west-2:PLACEHOLDER_ACCOUNT_ID:secret:knowledge-app/api-keys:semantic_scholar_api_key::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/knowledge-app",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "api"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8003/api/health')\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ],
  "_deploymentNotes": {
    "ecr_repos": [
      "knowledge-app"
    ],
    "build_commands": [
      "docker build -t PLACEHOLDER_ACCOUNT_ID.dkr.ecr.us-west-2.amazonaws.com/knowledge-app:latest .",
      "aws ecr get-login-password --region us-west-2 | docker login --username AWS --password-stdin PLACEHOLDER_ACCOUNT_ID.dkr.ecr.us-west-2.amazonaws.com",
      "docker push PLACEHOLDER_ACCOUNT_ID.dkr.ecr.us-west-2.amazonaws.com/knowledge-app:latest"
    ],
    "iam_requirements": {
      "task_role": "Needs s3:GetObject, s3:PutObject, s3:ListBucket on astrolabe-datalake bucket (papers/ prefix)",
      "execution_role": "Needs ecr:GetAuthorizationToken, ecr:BatchGetImage, secretsmanager:GetSecretValue"
    },
    "alb": {
      "target_group_port": 8003,
      "health_check_path": "/api/health",
      "subdomain": "knowledge.astrolabe-analytics.com"
    }
  }
}
