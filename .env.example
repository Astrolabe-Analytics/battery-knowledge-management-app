# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/astrolabe

# Anthropic API (required for RAG and AI summaries)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Semantic Scholar (optional — improves DOI discovery for papers without DOI)
SEMANTIC_SCHOLAR_API_KEY=

# PDF Storage
# PAPERS_STORAGE=local   (default) local filesystem at papers/
# PAPERS_STORAGE=s3      AWS S3 or LocalStack — set this in production
PAPERS_STORAGE=

# S3 settings (required when PAPERS_STORAGE=s3)
PAPERS_S3_BUCKET=astrolabe-datalake
AWS_REGION=us-west-2
# Uncomment for LocalStack (local S3 testing):
# AWS_ENDPOINT=http://localhost:4566
