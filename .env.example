# ── Astrolabe Environment Configuration ──────────────────
# Copy this file to .env and fill in the values.

# ── Authentication ───────────────────────────────────────
# Shared company password. Everyone logs in with this.
# Leave blank to disable auth (open access — dev mode only).
AUTH_PASSWORD=

# Secret key for signing auth tokens. Auto-derived from AUTH_PASSWORD if not set.
# Set this to a long random string in production for extra security.
# AUTH_SECRET_KEY=

# ── Database ─────────────────────────────────────────────
# PostgreSQL password (used by docker-compose.prod.yml)
POSTGRES_PASSWORD=changeme

# PostgreSQL connection string (set by docker-compose automatically — don't change unless custom setup)
# DATABASE_URL=postgresql+psycopg2://postgres:changeme@postgres:5432/astrolabe

# ── API Keys ─────────────────────────────────────────────
# Anthropic API key (required for RAG search / AI features)
ANTHROPIC_API_KEY=

# Semantic Scholar API key (optional — increases rate limits)
# SEMANTIC_SCHOLAR_API_KEY=

# ── CORS ─────────────────────────────────────────────────
# Comma-separated allowed origins (set by docker-compose automatically)
# CORS_ORIGINS=http://localhost,http://localhost:80
