# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/astrolabe

# Anthropic API (required for RAG and AI summaries)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Semantic Scholar (optional — improves DOI discovery for papers without DOI)
SEMANTIC_SCHOLAR_API_KEY=

# PDF Storage
# PAPERS_STORAGE=local   (default) local filesystem at papers/
# PAPERS_STORAGE=s3      AWS S3 or LocalStack — set this in production
PAPERS_STORAGE=

# S3 settings (required when PAPERS_STORAGE=s3)
PAPERS_S3_BUCKET=astrolabe-datalake
AWS_REGION=us-west-2
# LocalStack endpoint (LOCAL DEV ONLY — never set in staging/production):
# - API on host: AWS_ENDPOINT=http://localhost:4566
# - API in Docker Compose: AWS_ENDPOINT=http://host.docker.internal:4566
# - Production ECS: DO NOT SET AWS_ENDPOINT (use real AWS S3 via IAM/task role)
# AWS_ENDPOINT=http://localhost:4566

# =====================================================================
# LocalStack dummy credentials (LOCAL DEV ONLY — NEVER IN PRODUCTION)
# =====================================================================
# Uncomment only when testing with LocalStack (--profile s3):
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# In production ECS: do not set these; IAM task role provides credentials.
